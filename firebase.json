{
  "hosting": {
    "site": "auric-code-web",
    "public": "dist",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "auricai/**",
      "downloads/**",
      "**/*.exe",
      "**/*.apk",
      "**/*.dll",
      "**/*.zip",
      "install.ps1",
      "archivo/**",
      "qa/**",
      "README.md",
      ".github/**"
    ],
    "headers": [
      {
        "source": "/release.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "cleanUrls": true
  }
}
